package cli;

#[comptime_derive]
fn attribute_next(attribute: MetaAttribute, index: isize) -> (string, string, bool, isize) {
    let kind = meta_attribute_argument_kind(attribute, index);
    if kind == "ident" {
        return (meta_attribute_argument_text(attribute, index), "", false, index + 1)
    }
    if kind != "named" || meta_attribute_argument_value_kind(attribute, index) != "string" {
        let _ = derive_error_at_argument(
            attribute,
            index,
            "CLI attributes require identifiers and named string values",
        );
    }
    return (
        meta_attribute_argument_name(attribute, index),
        meta_attribute_argument_text(attribute, index),
        true,
        index + 1,
    )
}

#[comptime_derive]
fn validate_attribute_syntax(attribute: MetaAttribute) -> () {
    let names: Vec[string] = Vec::new();
    for index in 0..meta_attribute_argument_count(attribute) {
        let current = attribute_next(attribute, index);
        for previous in 0..names.len() {
            if names.get(previous) == current.0 {
                let _ = derive_error_at_argument(
                    attribute,
                    index,
                    "duplicate CLI attribute: " + current.0,
                );
            }
        }
        names.push(current.0);
    }
}

#[comptime_derive]
fn attribute_has(attribute: MetaAttribute, key: string, named: bool) -> bool {
    for index in 0..meta_attribute_argument_count(attribute) {
        let current = attribute_next(attribute, index);
        if current.0 == key && current.2 == named {
            return true
        }
    }
    false
}
